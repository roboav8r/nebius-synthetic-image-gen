# Copy to .env (gitignored) and fill in. See NEBIUS_SETUP.md.
# Nothing here is committed; the configs only refer to these names.

# Object Storage bucket the jobs upload to and the notebook reads from.
SDG_BUCKET=
SDG_S3_ENDPOINT=https://storage.<region>.nebius.cloud
SDG_S3_REGION=

# S3 access key for the service account. Used locally by the notebook only;
# jobs get the same values from the MysteryBox secret named below.
NEBIUS_S3_ACCESS_KEY_ID=
NEBIUS_S3_SECRET_ACCESS_KEY=

# MysteryBox secret holding the two keys above (default: sdg-s3).
SDG_SECRET=sdg-s3

# Container Registry the job image is pushed to, as cr.<region>.nebius.cloud/<registry-id>.
# See NEBIUS_SETUP.md step 7.
SDG_REGISTRY=

# Shared filesystem ID (computefilesystem-...). Jobs keep Isaac's caches on it.
# See NEBIUS_SETUP.md step 8.
SDG_SHARED_FS=

# Optional: only if your project has more than one subnet.
NEBIUS_SUBNET_ID=
