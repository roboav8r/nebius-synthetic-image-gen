# Copy to .env (gitignored) and fill in. See docs/NEBIUS_SETUP.md.

# Object Storage bucket the jobs upload to and the notebook reads from (step 3).
SDG_BUCKET=
SDG_S3_ENDPOINT=https://storage.<region>.nebius.cloud
SDG_S3_REGION=

# The service account's S3 access key (step 4). Used locally; jobs read the
# same values from the MysteryBox secret below.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# MysteryBox secret holding the two keys above (step 6).
SDG_SECRET=sdg-s3

# Container Registry for the job image, cr.<region>.nebius.cloud/<registry-id> (step 7).
SDG_REGISTRY=

# Shared filesystem ID, computefilesystem-..., for Isaac's caches (step 8).
SDG_SHARED_FS=

# Optional: only if your project has more than one subnet (step 9).
SDG_SUBNET_ID=
